# ---------- Frontend (Vite inlines VITE_* at build time — nothing secret here) ----------
VITE_API_URL=http://localhost:8000

# ---------- Backend only — NEVER expose to the browser ----------
# Atlas → Connect → Drivers → Python. Percent-encode special characters in the password (@ → %40).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=EZTracker
MONGODB_DB=eztracker
# make keygen-jwt
AUTH_JWT_SECRET=
# make keygen
CREDENTIALS_ENCRYPTION_KEY=

FRONTEND_ORIGIN=http://localhost:5173
NEXUS_BASE_URL=https://students.mesaschool.co.in
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO

# ---------- Discovery only (local `make discover`; never deployed) ----------
NEXUS_EMAIL=
NEXUS_PASSWORD=
